# Only inputs used by the application Dockerfiles belong in the build context.
**
!gradlew
!build.gradle
!settings.gradle
!gradle/
!gradle/wrapper/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!backend/
!backend/src/
!backend/src/main/
!backend/src/main/java/
!backend/src/main/java/**
!backend/src/main/resources/
!backend/src/main/resources/**
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/nginx.conf
!frontend/src/
!frontend/src/**
!evaluation/
!evaluation/fixtures/
!evaluation/fixtures/synthetic-public-v1.json
!evaluation/export_labels.json

# Local credentials and generated files are never build inputs.
**/.env
**/.env.*
**/.git
**/.git/**
**/node_modules
**/node_modules/**
**/build
**/build/**
**/dist
**/dist/**
**/.cache
**/.cache/**
**/coverage
**/coverage/**
**/test-results
**/test-results/**
**/playwright-report
**/playwright-report/**
**/*.log
**/*.har
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*~
**/*.bak
